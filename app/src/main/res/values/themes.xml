<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- =============================================================
         Тема приложения (светлая).
         Использует цвета из дизайн-системы PWA.
         ============================================================= -->
    <style name="Theme.Jurist78" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основной цвет (Mint из PWA) -->
        <item name="colorPrimary">#3d9c8c</item>
        <!-- Тёмный вариант Mint -->
        <item name="colorPrimaryVariant">#2d8c7c</item>
        <!-- Цвет текста на основном фоне -->
        <item name="colorOnPrimary">#ffffff</item>
        <!-- Вторичный цвет (Navy из PWA) -->
        <item name="colorSecondary">#2c4a5e</item>
        <!-- Цвет текста на вторичном фоне -->
        <item name="colorOnSecondary">#ffffff</item>
        <!-- Цвет статус-бара -->
        <item name="android:statusBarColor">#3d9c8c</item>
    </style>
</resources>